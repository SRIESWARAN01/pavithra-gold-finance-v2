rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions & Role Hierarchy
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (hasProfile() ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role : null);
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'Admin' ||
        request.auth.token.role == 'Owner' ||
        getUserRole() == 'Admin' ||
        getUserRole() == 'Owner' ||
        request.auth.token.email == '7094826586@pgf.local' ||
        request.auth.token.phone_number == '+917094826586'
      );
    }

    function isManager() {
      return isAdmin() || (hasProfile() && getUserRole() == 'Manager');
    }

    function isStaff() {
      return isAuthenticated() && (
        isAdmin() ||
        isManager() ||
        request.auth.token.role in ['Admin', 'Owner', 'Manager', 'Appraiser', 'Cashier', 'Employee', 'Accountant'] ||
        (hasProfile() && getUserRole() in ['Admin', 'Owner', 'Manager', 'Appraiser', 'Cashier', 'Employee', 'Accountant']) ||
        request.auth.token.email == '7094826586@pgf.local'
      );
    }

    function isCustomer() {
      return isAuthenticated() && getUserRole() == 'Customer';
    }

    function isInvestor() {
      return isAuthenticated() && (request.auth.token.role == 'Investor' || getUserRole() == 'Investor');
    }

    // =========================================================================
    // Profiles
    // =========================================================================
    match /profiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Branches
    // =========================================================================
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // Loans
    // =========================================================================
    match /loans/{loanId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customer_id == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Gold Collateral & Photos
    // =========================================================================
    match /gold_collateral/{itemId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customer_id == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /gold_photos/{photoId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customer_id == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Payments
    // =========================================================================
    match /payments/{paymentId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customer_id == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Expenses & Expense Categories
    // =========================================================================
    match /expenses/{expenseId} {
      allow read, write: if isStaff();
    }

    match /expense_categories/{catId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // =========================================================================
    // Loan Renewals
    // =========================================================================
    match /loan_renewals/{renewalId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customer_id == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Approval Requests
    // =========================================================================
    match /approval_requests/{reqId} {
      allow read, write: if isStaff();
    }

    // =========================================================================
    // Bank Re-Pledges
    // =========================================================================
    match /bankRePledges/{pledgeId} {
      allow read, write: if isStaff();
    }

    // =========================================================================
    // Bill Slogans
    // =========================================================================
    match /billSlogans/{sloganId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // =========================================================================
    // Interest Accruals
    // =========================================================================
    match /interest_accruals/{accrualId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customer_id == request.auth.uid);
      allow write: if isStaff();
    }

    // =========================================================================
    // Notifications & Reminders
    // =========================================================================
    match /notifications/{notifId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.recipient_id == request.auth.uid || resource.data.recipient_id == 'admin_broadcast'));
      allow create: if isStaff();
      allow update: if isStaff() || (isAuthenticated() && resource.data.recipient_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /whatsapp_reminders/{reminderId} {
      allow read, write: if isStaff();
    }

    // =========================================================================
    // Settings
    // =========================================================================
    match /settings/{settingKey} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // Audit Logs
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    // Counters
    // =========================================================================
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // Accounting Journals & Documents
    // =========================================================================
    match /accounting_journals/{journalId} {
      allow read, write: if isStaff();
    }

    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /auction_bids/{bidId} {
      allow read, write: if isStaff();
    }

    match /support_tickets/{ticketId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // Investment Portfolio Module Collections
    // =========================================================================
    match /investors/{investorId} {
      allow read, write: if isStaff() || (isAuthenticated() && (request.auth.uid == investorId || resource.data.uid == request.auth.uid));
    }

    match /investment_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /investment_accounts/{accountId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow write: if isStaff();
    }

    match /investment_lots/{lotId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow write: if isStaff();
    }

    match /investment_transactions/{txnId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow write: if isStaff();
    }

    match /withdrawal_requests/{wdrId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.investor_id == request.auth.uid || request.resource.data.investorId == request.auth.uid);
      allow update, delete: if isStaff();
    }

    match /investment_payment_requests/{reqId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.investor_id == request.auth.uid || request.resource.data.investorId == request.auth.uid);
      allow update, delete: if isStaff();
    }

    match /investment_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /investment_notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    match /investment_audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
