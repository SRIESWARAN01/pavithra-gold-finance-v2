rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions & Role Hierarchy
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (hasProfile() ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role : null);
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['Admin', 'admin', 'ADMIN', 'Owner', 'owner', 'OWNER'] ||
        getUserRole() in ['Admin', 'admin', 'ADMIN', 'Owner', 'owner', 'OWNER'] ||
        (request.auth.token.email != null && (
          request.auth.token.email == '7094826586@pgf.local' ||
          request.auth.token.email.matches('.*admin.*') ||
          request.auth.token.email.matches('.*owner.*')
        )) ||
        request.auth.token.phone_number == '+917094826586'
      );
    }

    function isManager() {
      return isAdmin() || (
        request.auth.token.role in ['Manager', 'manager', 'MANAGER'] ||
        (hasProfile() && getUserRole() in ['Manager', 'manager', 'MANAGER'])
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        isAdmin() ||
        isManager() ||
        request.auth.token.role in [
          'Admin', 'admin', 'ADMIN', 'Owner', 'owner', 'OWNER',
          'Manager', 'manager', 'MANAGER',
          'Appraiser', 'appraiser', 'APPRAISER',
          'Cashier', 'cashier', 'CASHIER',
          'Employee', 'employee', 'EMPLOYEE',
          'Accountant', 'accountant', 'ACCOUNTANT',
          'Collection_Officer', 'collection_officer',
          'Customer_Support', 'customer_support',
          'Staff', 'staff', 'STAFF'
        ] ||
        (hasProfile() && getUserRole() in [
          'Admin', 'admin', 'ADMIN', 'Owner', 'owner', 'OWNER',
          'Manager', 'manager', 'MANAGER',
          'Appraiser', 'appraiser', 'APPRAISER',
          'Cashier', 'cashier', 'CASHIER',
          'Employee', 'employee', 'EMPLOYEE',
          'Accountant', 'accountant', 'ACCOUNTANT',
          'Collection_Officer', 'collection_officer',
          'Customer_Support', 'customer_support',
          'Staff', 'staff', 'STAFF'
        ]) ||
        (request.auth.token.email != null && (
          request.auth.token.email == '7094826586@pgf.local' ||
          request.auth.token.email.matches('.*@pgf[.]local')
        ))
      );
    }

    function isCustomer() {
      return isAuthenticated() && (
        request.auth.token.role in ['Customer', 'customer', 'CUSTOMER'] ||
        getUserRole() in ['Customer', 'customer', 'CUSTOMER']
      );
    }

    function isInvestor() {
      return isAuthenticated() && (
        request.auth.token.role in ['Investor', 'investor', 'INVESTOR'] ||
        getUserRole() in ['Investor', 'investor', 'INVESTOR']
      );
    }

    // =========================================================================
    // Profiles
    // =========================================================================
    match /profiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == profileId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Branches
    // =========================================================================
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // =========================================================================
    // Loans
    // =========================================================================
    match /loans/{loanId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.customer_id == request.auth.uid));
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Gold Collateral & Photos
    // =========================================================================
    match /gold_collateral/{itemId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.customer_id == request.auth.uid));
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /gold_photos/{photoId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.customer_id == request.auth.uid));
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Payments
    // =========================================================================
    match /payments/{paymentId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.customer_id == request.auth.uid));
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Expenses & Expense Categories
    // =========================================================================
    match /expenses/{expenseId} {
      allow read, write: if isStaff();
    }

    match /expense_categories/{catId} {
      allow read, write: if isStaff();
    }

    // =========================================================================
    // Loan Renewals
    // =========================================================================
    match /loan_renewals/{renewalId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.customer_id == request.auth.uid));
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Approval Requests
    // =========================================================================
    match /approval_requests/{reqId} {
      allow read, write: if isStaff();
    }

    // =========================================================================
    // Bank Re-Pledges
    // =========================================================================
    match /bankRePledges/{pledgeId} {
      allow read, write: if isStaff();
    }

    // =========================================================================
    // Bill Slogans
    // =========================================================================
    match /billSlogans/{sloganId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // =========================================================================
    // Interest Accruals
    // =========================================================================
    match /interest_accruals/{accrualId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.customer_id == request.auth.uid));
      allow write: if isStaff();
    }

    // =========================================================================
    // Notifications & Reminders
    // =========================================================================
    match /notifications/{notifId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.recipient_id == request.auth.uid || resource.data.recipient_id == 'admin_broadcast'));
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && (resource == null || resource.data.recipient_id == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /whatsapp_reminders/{reminderId} {
      allow read, write: if isStaff();
    }

    // =========================================================================
    // Settings
    // =========================================================================
    match /settings/{settingKey} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // Audit Logs
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    // Counters
    // =========================================================================
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // =========================================================================
    // Accounting Journals & Documents
    // =========================================================================
    match /accounting_journals/{journalId} {
      allow read, write: if isStaff();
    }

    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /auction_bids/{bidId} {
      allow read, write: if isStaff();
    }

    match /support_tickets/{ticketId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.customer_id == request.auth.uid || resource.data.customerId == request.auth.uid || resource.data.user_id == request.auth.uid));
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && (resource != null && (resource.data.customer_id == request.auth.uid || resource.data.customerId == request.auth.uid || resource.data.user_id == request.auth.uid)));
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Investment Portfolio Module Collections
    // =========================================================================
    match /investors/{investorId} {
      allow read: if isStaff() || (isAuthenticated() && (request.auth.uid == investorId || (resource != null && resource.data.uid == request.auth.uid)));
      allow create: if isStaff() || (isAuthenticated() && (request.auth.uid == investorId || request.resource.data.uid == request.auth.uid));
      allow update: if isStaff() || (isAuthenticated() && (request.auth.uid == investorId || (resource != null && resource.data.uid == request.auth.uid)));
      allow delete: if isAdmin();
    }

    match /investment_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /investment_accounts/{accountId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow create: if isStaff() || (isAuthenticated() && (accountId == request.auth.uid || request.resource.data.investor_id == request.auth.uid || request.resource.data.investorId == request.auth.uid));
      allow update: if isStaff() || (isAuthenticated() && (accountId == request.auth.uid || (resource != null && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid))));
      allow delete: if isAdmin();
    }

    match /investment_lots/{lotId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow create: if isStaff() || (isAuthenticated() && (request.resource.data.investor_id == request.auth.uid || request.resource.data.investorId == request.auth.uid));
      allow update, delete: if isStaff();
    }

    match /investment_transactions/{txnId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow create: if isStaff() || (isAuthenticated() && (request.resource.data.investor_id == request.auth.uid || request.resource.data.investorId == request.auth.uid));
      allow update, delete: if isStaff();
    }

    match /withdrawal_requests/{wdrId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.investor_id == request.auth.uid || request.resource.data.investorId == request.auth.uid);
      allow update, delete: if isStaff();
    }

    match /investment_payment_requests/{reqId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.investor_id == request.auth.uid || request.resource.data.investorId == request.auth.uid);
      allow update, delete: if isStaff();
    }

    match /investment_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /investment_notifications/{notifId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.investor_id == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /investment_audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
